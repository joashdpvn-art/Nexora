# Optional Real LLM Provider Configuration
# NEXORA automatically detects any of the supported real AI providers below via environment variables.
# If no key is provided, it gracefully uses its local offline reasoning engine.

# Option 1: Groq (Recommended - ultra-fast inference)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Option 3: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# Option 4: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
